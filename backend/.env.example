# Database Configuration
# Leave DATABASE_URL unset for local SQLite, or set to PostgreSQL URL for production
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudinary Configuration (Optional - for cloud image/PDF storage)
# Get these from https://cloudinary.com/console
# If not set, app will use local file storage (files lost on redeploy in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Frontend URL (Optional - for CORS)
# FRONTEND_URL=http://localhost:3000

# App Authentication
# Required to enable the login screen and protect the app.
# APP_AUTH_USERNAME=alice
# APP_AUTH_PASSWORD=very-strong-password
# Required for password recovery and MFA: stable cookie-signing/encryption secret distinct from APP_AUTH_PASSWORD
# APP_AUTH_SECRET=extra-secret-key
# Optional: force secure cookies (enable in production with HTTPS)
# APP_AUTH_COOKIE_SECURE=true
# Optional: seven-day maximum for "Keep me signed in" (defaults to seven days)
# APP_REMEMBER_SESSION_DURATION_SECONDS=604800
# Password recovery requires a verified account recovery address and SMTP delivery.
# APP_AUTH_RECOVERY_EMAIL=owner@example.com
# APP_PUBLIC_URL=https://your-app.example.com
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=587
# APP_SMTP_FROM=security@your-app.example.com
# APP_SMTP_USERNAME=your-smtp-user
# APP_SMTP_PASSWORD=your-smtp-password
