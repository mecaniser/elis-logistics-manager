# Database Configuration
# Leave DATABASE_URL unset for local SQLite, or set to PostgreSQL URL for production
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudinary Configuration (Optional - for cloud image/PDF storage)
# Get these from https://cloudinary.com/console
# If not set, app will use local file storage (files lost on redeploy in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Frontend URL (Optional - for CORS)
# FRONTEND_URL=http://localhost:3000

# App Authentication
# Required to enable the login screen and protect the app.
# APP_AUTH_USERNAME=alice
# APP_AUTH_PASSWORD=very-strong-password
# Required for password recovery and MFA: stable cookie-signing/encryption secret distinct from APP_AUTH_PASSWORD
# APP_AUTH_SECRET=extra-secret-key
# Optional: force secure cookies (enable in production with HTTPS)
# APP_AUTH_COOKIE_SECURE=true
# Optional: seven-day maximum for "Keep me signed in" (defaults to seven days)
# APP_REMEMBER_SESSION_DURATION_SECONDS=604800
# Password recovery requires a verified account recovery address and email delivery.
# APP_AUTH_RECOVERY_EMAIL=owner@example.com
# APP_PUBLIC_URL=https://your-app.example.com
# HTTPS delivery through Resend (recommended for Railway Free, Trial, and Hobby):
# APP_RESEND_API_KEY=your-resend-api-key
# APP_EMAIL_FROM=security@your-verified-domain.example.com
# Alternatively, SMTP (Railway Pro and above):
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=587
# APP_SMTP_FROM=security@your-app.example.com
# APP_SMTP_USERNAME=your-smtp-user
# APP_SMTP_PASSWORD=your-smtp-password

# DB-094: server-managed DieselBridge read-only connections (default disabled).
# Each connection has an explicitly authorized ELIS tenant, shop and bill-to ID.
# Store the actual API key separately using the named api_key_env secret.
# ELIS_DIESELBRIDGE_CONNECTIONS=[{"slug":"repair-shop","tenant_id":1,"shop_id":"<shop-uuid>","bill_to_id":"<customer-uuid>","base_url":"https://<dieselbridge-host>","api_key_env":"DIESELBRIDGE_REPAIR_SHOP_KEY"}]
# Configure DIESELBRIDGE_REPAIR_SHOP_KEY through the server secret manager.
