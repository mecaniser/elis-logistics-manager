# Database Configuration
# Leave DATABASE_URL unset for local SQLite, or set to PostgreSQL URL for production
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudinary Configuration (Optional - for cloud image/PDF storage)
# Get these from https://cloudinary.com/console
# If not set, app will use local file storage (files lost on redeploy in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Frontend URL (Optional - for CORS)
# FRONTEND_URL=http://localhost:3000

# App Authentication
# Required to enable the login screen and protect the app.
# APP_AUTH_USERNAME=alice
# APP_AUTH_PASSWORD=very-strong-password
# Optional: override cookie signing secret (defaults to APP_AUTH_PASSWORD)
# APP_AUTH_SECRET=extra-secret-key
# Optional: force secure cookies (enable in production with HTTPS)
# APP_AUTH_COOKIE_SECURE=true
